# BIGUS server sozlamalari. Bu faylni ".env" nomi bilan nusxalang va to'ldiring.

# Server porti (sayt shu manzilda ochiladi: http://localhost:4000)
PORT=4000

# Claude AI kaliti (AI yordamchi va maslahatlar uchun). https://console.anthropic.com
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-5-5

# Telegram eslatmalari uchun bot tokeni (@BotFather dan oling). Bo'sh bo'lsa eslatmalar o'chiq.
TELEGRAM_BOT_TOKEN=

# Vaqt mintaqasi ("bugun" qaysi kun ekanini aniqlash uchun)
BIGUS_TZ=Asia/Tashkent

# Birinchi ishga tushishda yaratiladigan admin (bo'sh bo'lsa parol avtomatik yaratiladi)
ADMIN_EMAIL=admin@bigus.uz
ADMIN_PASSWORD=

